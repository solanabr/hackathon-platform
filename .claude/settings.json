  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\") && [ -n \"$out\" ] && printf '%s' \"$out\" || { echo 'Guard hook failed to run; refusing the call.' >&2; exit 2; }",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\") && [ -n \"$out\" ] && printf '%s' \"$out\" || { echo 'Guard hook failed to run; refusing the call.' >&2; exit 2; }",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\") && [ -n \"$out\" ] && printf '%s' \"$out\" || { echo 'Guard hook failed to run; refusing the call.' >&2; exit 2; }",
