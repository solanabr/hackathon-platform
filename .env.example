# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-only: add-member lookup, admin pages, cron auto-lock.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token Vercel Cron sends to /api/cron/lock-submissions — openssl rand -base64 48
CRON_SECRET=
