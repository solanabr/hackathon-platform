# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-only: add-member lookup, admin pages, cron auto-lock.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email
RESEND_API_KEY=
RESEND_FROM=Superteam Brasil <no-reply@seu-dominio>
NEXT_PUBLIC_SITE_URL=https://hackathon.superteam.com.br

# Sentry — errors-only monitoring. Everything no-ops while the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time; without these Sentry shows minified stacks.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog — product analytics (US cloud). No-ops while the key is empty.
NEXT_PUBLIC_POSTHOG_KEY=
